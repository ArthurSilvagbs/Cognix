# Supabase — copie este arquivo para .env.local e preencha com os valores do seu
# projeto: painel do Supabase → Project Settings → Data API / API Keys.
# NEXT_PUBLIC_* são expostas ao navegador (a chave anon é pública por design;
# a segurança vem das policies/RLS no banco).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
